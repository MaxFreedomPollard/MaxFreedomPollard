    > /opt/rbpf-Cargo.lock

COPY . .

# Download the pinned dependencies; the tests run offline.
RUN cp /opt/rbpf-Cargo.lock Cargo.lock && cargo fetch --locked

# Build the dependencies, the Cranelift code generator among them, with
# optimizations so that JIT compilation in tests is fast; rbpf itself keeps
# the default test profile.
RUN printf '[profile.dev.package."*"]\nopt-level = 2\n' > "$CARGO_HOME/config.toml"

# Compile the library and every test target with all features, including the
# Cranelift JIT, without running any test. The tests may run as a user other
# than root, so every user may write the sources and the build folder.
RUN cargo build --locked --offline --all-features --tests \
    && chmod -R a+rwX /app

ENV CARGO_NET_OFFLINE=true

CMD ["/bin/bash"]
